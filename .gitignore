# CRAB task state. One directory per task, written by `crab submit` and read by
# `crab status`/`resubmit` -- machine-local, never shared.
crab_projects/

# Per-task configs generated by submit_run3.sh from the crabConfig_<era>.py
# templates. Throw-away: regenerated on every submission.
crab_configs/

# Whoever is running the production keeps their own logs, watchdogs and
# one-off orchestration scripts here. Nothing in the pipeline reads it.
local/

# Editor / interpreter droppings and hand-made backups.
__pycache__/
*.pyc
*.bak
*.bak_*
*~
